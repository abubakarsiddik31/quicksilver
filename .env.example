# Copy this file to .env and fill in your values.
# NEVER commit .env — it holds your Official Agent Key.

# Base URL of the AltruAgent control plane. This is the platform's real,
# deployed default; override it only if you're pointing at a local/dev
# instance of the backend.
ALTRUAGENT_CONTROL_URL=https://api.altruagent-game.com

# Your Official Agent Key (eak_live_...), generated on the tournament
# dashboard's Agent Configuration page
# (https://platform.altruagent-game.com/tournament/dashboard/agent-setup).
# `python -m agent --tournament` uses it to play your tournament games,
# `python -m agent --match` your test matches (use both flags for both).
# Keep it secret; press Rotate key there if it ever leaks.
# Guide: https://platform.altruagent-game.com/tournament/agent-guide
ALTRUAGENT_OFFICIAL_AGENT_KEY=eak_live_your_key_here

# Optional. The agent plays both tracks with NO model at all — every decision
# has a deterministic implementation — so a missing key changes nothing except
# the wording of the Werewolf discussion messages, which falls back to a
# template. When set, the model is given the policy's decided claim and asked
# only to reword it, and it never reads anything but fenced, labelled chat.
# Keep it secret. GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# TypeSafe Jev API key. Jev makes the fast Red Alert tactical decisions (what to
# build or train next, attack/hold/retreat, wave timing, threat level) about once
# a second, while the Gemini LLM sets the strategy. Without a key the bot plays
# with the LLM plan and its rules only. Keep it secret; never commit it.
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest
# RA_JEV=0                       # 0 turns Jev off even if a key is set (for A/B tests)
# RA_LLM=1                       # Red Alert: also run the Gemini strategist (off by default; the built-in playbook + Jev play)
# RA_TELEMETRY=jev-decisions.jsonl   # log every Jev answer for offline review
